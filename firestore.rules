rules_version = '2';

// ============================================================================
// P MARCOM ACADEMY — Firestore Security Rules
//
// VÌ SAO TỆP NÀY LÀ BẮT BUỘC
//
// Ứng dụng chạy hoàn toàn trong trình duyệt, không có backend. Mọi thứ ở phía
// trình duyệt đều sửa được: localStorage, biến state, thậm chí cả mã JavaScript
// đang chạy. Nghĩa là KHÔNG có cách nào chặn một người tự bật giao diện quản trị
// trên máy của họ.
//
// Nhưng đó không phải điều cần chặn. Điều cần chặn là họ LẤY ĐƯỢC DỮ LIỆU và
// SỬA ĐƯỢC PHÂN QUYỀN. Cả hai việc đó đều phải đi qua máy chủ Firestore, và máy
// chủ chỉ tin ID token do Firebase Auth ký — không tin bất cứ thứ gì trình duyệt
// tự khai. Tệp này là nơi duy nhất đặt được ranh giới đó.
//
// Nói ngắn: giao diện giả được, dữ liệu thì không.
//
// TRIỂN KHAI: xem DEPLOYMENT.md, mục "Security Rules".
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Hàm dùng chung --------------------------------------------------
    // Khai báo trước mọi khối match bên dưới. Trình biên dịch rules đọc tuần tự
    // nên hàm dùng ở đâu phải được định nghĩa trước chỗ đó.

    function signedIn() {
      return request.auth != null;
    }

    // Email lấy từ ID token đã được Firebase Auth ký, KHÔNG phải từ
    // localStorage hay tham số do trình duyệt gửi lên. Đây là điểm mấu chốt:
    // người dùng khai gì cũng được, nhưng không ký được token.
    function myEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Tài khoản Quản Trị Tối Cao. Phải khớp ROOT_ADMIN_EMAILS trong
    // src/utils/adminRoles.js — đổi một bên thì đổi cả hai.
    //
    // Danh sách chứ không còn một địa chỉ: chỉ có duy nhất một tài khoản gốc là
    // một điểm hỏng duy nhất — mất quyền vào email đó là không ai còn đường mồi
    // lại sổ phân quyền, và cách chữa duy nhất là sửa mã nguồn rồi deploy lại.
    function rootAdminEmails() {
      return ['admin@pmarcom.edu.vn', 'pmarcomvn@gmail.com'];
    }

    function isRootAdminEmail(e) {
      return e in rootAdminEmails();
    }

    // Quyền quản trị = có bản ghi trong sổ /admins. Sổ đó chỉ quản trị viên
    // hiện hành mới ghi được (xem match /admins bên dưới), nên người ngoài
    // không có đường nào tự đưa mình vào.
    // Viết thẳng biểu thức trong $() thay vì gọi myEmail(): gọi hàm bên trong
    // đường dẫn không phải cú pháp chắc chắn được chấp nhận. Điều kiện
    // `email != null` đứng trước nên nhánh sau không bao giờ chạm vào null.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Chỉ quản trị viên đọc được hồ sơ người khác. Học viên đọc hồ sơ của mình.
    //
    // Vẫn cho đọc tài liệu KHÔNG tồn tại, vì getUserProgressFromCloud() dò theo
    // uid trong khi bản ghi lưu theo email nên thường xuyên chạm vào chỗ trống.
    // NHƯNG bắt buộc phải đăng nhập trước.
    //
    // Bản đầu tiên đặt `resource == null` ngoài điều kiện `signedIn()`, và thế
    // là hở một máy dò: người lạ thử đọc students/<email_đã_chuẩn_hoá>, nhận
    // 404 thì email đó chưa đăng ký, nhận 403 thì đã đăng ký. Đủ để rà xem một
    // người có học ở đây hay không mà không cần tài khoản nào.
    function canGetProfile() {
      return isAdmin()
        || (signedIn() && (resource == null || resource.data.email == myEmail()));
    }

    // Id tài liệu hợp lệ của CHÍNH người đang gọi.
    //
    // Ứng dụng lưu hồ sơ theo hai id (xem recordStudentAccountToCloud): id suy
    // ra từ email — email chữ thường, mọi ký tự ngoài [a-z0-9] đổi thành '_' —
    // và uid của Firebase Auth. Phép biến đổi ở đây phải khớp ĐÚNG với phía
    // JavaScript, lệch một ký tự là học viên không đăng ký được.
    function myDocId() {
      return myEmail().replace('[^a-z0-9]', '_');
    }

    // Học viên chỉ tạo được hồ sơ mang đúng email của mình, ĐẶT ĐÚNG CHỖ của
    // mình, và KHÔNG được kèm trường `role`.
    //
    // Trường `role` là đường tự phong hiển nhiên nhất nếu bỏ ngỏ.
    //
    // Ràng buộc id tài liệu là chốt chặn thứ hai, và nó chặn một kiểu phá hoại
    // khác hẳn: bản trước chỉ soi NỘI DUNG chứ không soi CHỖ ĐẶT, nên một tài
    // khoản hợp lệ tạo được tài liệu students/<id_suy_từ_email_người_khác> mang
    // email của chính nó. Tài liệu đó chiếm sẵn chỗ của nạn nhân; tới lượt nạn
    // nhân đăng ký, lệnh ghi trở thành `update` trên tài liệu của người khác và
    // bị canUpdateProfile() từ chối. Kết quả: nạn nhân vĩnh viễn không lưu được
    // hồ sơ lên hệ thống, và làm hàng loạt chỉ tốn một vòng lặp. Quản trị viên
    // vẫn được đặt tuỳ ý vì còn phải cấp bằng thủ công cho người chưa có tài
    // khoản (xem AdminDashboardModal).
    // `docId` truyền vào làm tham số chứ không đọc thẳng: biến bắt trong
    // `match /students/{docId}` chỉ tồn tại bên trong khối đó, hàm khai báo ở
    // tầng ngoài không nhìn thấy nó.
    function canCreateProfile(docId) {
      return isAdmin()
        || (signedIn()
            && request.resource.data.email == myEmail()
            && !('role' in request.resource.data)
            && (docId == myDocId() || docId == request.auth.uid));
    }

    // Tương tự khi cập nhật: học viên sửa hồ sơ của mình nhưng không được động
    // vào `role`, và không được đổi email sang người khác.
    function canUpdateProfile() {
      return isAdmin()
        || (signedIn()
            && resource.data.email == myEmail()
            && request.resource.data.email == myEmail()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }

    // Bộ đếm chỉ được tăng, mỗi lần ghi tối đa 1. Viết tường minh từng trường
    // thay vì truyền tên trường vào hàm, để không phụ thuộc vào cú pháp truy
    // cập map bằng biến.
    function visitsOk() {
      return !('totalVisits' in request.resource.data)
        || !('totalVisits' in resource.data)
        || (request.resource.data.totalVisits is int
            && request.resource.data.totalVisits >= resource.data.totalVisits
            && request.resource.data.totalVisits <= resource.data.totalVisits + 1);
    }

    function enrolledOk() {
      return !('totalEnrolled' in request.resource.data)
        || !('totalEnrolled' in resource.data)
        || (request.resource.data.totalEnrolled is int
            && request.resource.data.totalEnrolled >= resource.data.totalEnrolled
            && request.resource.data.totalEnrolled <= resource.data.totalEnrolled + 1);
    }

    function graduatesOk() {
      return !('totalGraduates' in request.resource.data)
        || !('totalGraduates' in resource.data)
        || (request.resource.data.totalGraduates is int
            && request.resource.data.totalGraduates >= resource.data.totalGraduates
            && request.resource.data.totalGraduates <= resource.data.totalGraduates + 1);
    }

    // ---- /admins : sổ phân quyền ----------------------------------------

    match /admins/{adminEmail} {

      // Mỗi người chỉ đọc được bản ghi của chính mình (để biết mình có quyền
      // không). Chỉ quản trị viên mới liệt kê được cả sổ.
      allow get: if signedIn() && (adminEmail == myEmail() || isAdmin());
      allow list: if isAdmin();

      // NÂNG QUYỀN: chỉ quản trị viên hiện hành mới cấp được cho người khác.
      //
      // Ngoại lệ duy nhất là bước mồi lần đầu: tài khoản gốc tự tạo bản ghi của
      // CHÍNH NÓ khi sổ còn rỗng. Không có ngoại lệ này thì sổ rỗng sẽ khoá
      // vĩnh viễn — không ai là admin nên không ai cấp được cho ai.
      // An toàn vì điều kiện buộc email trong token phải đúng bằng tài khoản
      // gốc, tức là phải đăng nhập được vào chính tài khoản đó.
      allow create: if isAdmin()
                    || (adminEmail == myEmail() && isRootAdminEmail(myEmail()));

      // Không ai sửa hay xoá được bản ghi của Quản Trị Tối Cao — kể cả một quản
      // trị viên khác, kể cả chính nó. Đây là chốt chặn "không tài khoản nào
      // được phép gỡ quyền quản trị cao nhất", đặt ở phía máy chủ nên không
      // vòng qua được bằng cách sửa giao diện.
      allow update: if isAdmin() && !isRootAdminEmail(adminEmail);
      allow delete: if isAdmin() && !isRootAdminEmail(adminEmail);
    }

    // ---- /students và /registrations : hồ sơ học viên ---------------------
    // Hai collection ghi cùng payload (xem DATABASE.md), nên dùng chung luật.

    match /students/{docId} {
      allow get: if canGetProfile();
      allow list: if isAdmin();
      allow create: if canCreateProfile(docId);
      allow update: if canUpdateProfile();
      allow delete: if isAdmin();
    }

    match /registrations/{docId} {
      allow get: if canGetProfile();
      allow list: if isAdmin();
      allow create: if canCreateProfile(docId);
      allow update: if canUpdateProfile();
      allow delete: if isAdmin();
    }

    // ---- /support_messages : hộp thư hỗ trợ của học viên ------------------
    //
    // Học viên gửi lời nhắn từ khung chat Pipi, quản trị viên đọc trong Hộp Thư
    // Hỗ Trợ. Id tài liệu do Firestore tự sinh nên không đoán được — đó cũng là
    // lý do cho phép chính chủ `get` mà không hở máy dò như ở /students.

    match /support_messages/{msgId} {

      // Quản trị viên đọc tất cả. Học viên chỉ đọc lại lời nhắn của chính mình,
      // và chỉ khi tài liệu CÓ THẬT: bỏ điều kiện `resource != null` là mở lại
      // đúng máy dò đã bịt ở canGetProfile().
      allow get: if isAdmin()
                 || (signedIn() && resource != null && resource.data.email == myEmail());

      // Học viên liệt kê được cuộc trao đổi CỦA CHÍNH MÌNH — cần cho hộp thư
      // trong khung chat Pipi. An toàn nhờ cách Firestore xét quyền cho truy
      // vấn: lệnh liệt kê chỉ được chấp nhận khi bản thân truy vấn bảo đảm mọi
      // tài liệu trả về đều thoả điều kiện, tức là phía máy khách BẮT BUỘC phải
      // lọc `where('email','==', <email của mình>)`. Truy vấn không lọc sẽ bị
      // máy chủ từ chối thẳng, chứ không phải lọc bớt rồi trả về.
      allow list: if isAdmin()
                  || (signedIn() && resource.data.email == myEmail());

      // Phải đăng nhập, và `email` bắt buộc khớp email trong ID token — không có
      // điều kiện này thì ai cũng gửi được lời nhắn mạo danh học viên khác.
      //
      // Trạng thái ban đầu ép cứng là 'new': người gửi không được tự đánh dấu
      // lời nhắn của mình là đã xử lý, vì như vậy nó sẽ không bao giờ nổi lên
      // trong bộ đếm chưa đọc của quản trị viên.
      //
      // Giới hạn độ dài đặt Ở ĐÂY chứ không chỉ ở ô nhập: giới hạn trên giao
      // diện chỉ ràng buộc người dùng ô nhập đó, còn lệnh ghi gửi thẳng thì
      // không đi qua nó. 2000 phải khớp SUPPORT_MESSAGE_MAX trong src/firebase.js.
      allow create: if signedIn()
                    && request.resource.data.email == myEmail()
                    && request.resource.data.status == 'new'
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 120;

      // Đánh dấu đã đọc / đã xử lý và xoá: chỉ quản trị viên.
      //
      // Học viên được sửa ĐÚNG bốn trường điều phối của cuộc trao đổi, không
      // hơn. `hasOnly` là mấu chốt: nó chặn mọi khoá ngoài danh sách, nên nội
      // dung `message` đã gửi và trường `email` định danh vẫn bất biến — Ban
      // Quản Trị luôn đọc đúng nội dung lúc gửi.
      //
      // Riêng `status`, học viên chỉ được đặt về 'new'. Cho phép đặt tuỳ ý thì
      // họ tự đánh dấu 'done' được, và cuộc trao đổi biến mất khỏi bộ đếm chưa
      // đọc của Ban Quản Trị trong khi vẫn đang chờ trả lời. Đặt về 'new' thì
      // ngược lại — đó chính là việc cần xảy ra khi học viên nhắn tiếp.
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.email == myEmail()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'studentUnread', 'lastReplyAt', 'lastReplyFrom'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                            || request.resource.data.status == 'new'));

      allow delete: if isAdmin();
    }

    // ---- /support_messages/{msgId}/replies : lượt trao đổi qua lại ---------
    //
    // Mỗi lượt trả lời là một tài liệu riêng, không phải phần tử trong một mảng
    // trên tài liệu cha. Mảng thì mỗi lần thêm phải ghi lại toàn bộ tài liệu —
    // hai người cùng trả lời một lúc là mất một lượt — và luật không soi được
    // từng phần tử bên trong, tức là không chặn được việc mạo danh.

    match /support_messages/{msgId}/replies/{replyId} {

      // Email của người mở cuộc trao đổi. Đọc từ tài liệu cha nên không giả được.
      function threadOwner() {
        return get(/databases/$(database)/documents/support_messages/$(msgId)).data.email;
      }

      // Đọc theo `threadEmail` chép sẵn trên chính lượt trả lời, KHÔNG gọi
      // threadOwner(): đọc là việc diễn ra liên tục, mà mỗi lần gọi get() trong
      // luật là một lượt đọc tính tiền. Ghi thì hiếm, nên chỗ đó mới đối chiếu
      // với tài liệu cha (xem `create` bên dưới) — và chính phép đối chiếu lúc
      // ghi mới là thứ bảo đảm `threadEmail` ở đây đáng tin.
      allow get, list: if isAdmin()
                       || (signedIn() && resource.data.threadEmail == myEmail());

      // Ai gửi được, và gửi được DANH NGHĨA nào:
      //   - Quản trị viên: gửi với `from == 'admin'`, vào bất kỳ cuộc nào.
      //   - Học viên: chỉ vào cuộc trao đổi của chính mình, và chỉ với
      //     `from == 'student'`.
      //
      // Vế `from` không phải chuyện hình thức: thiếu nó thì một học viên bất kỳ
      // ghi được lượt trả lời mang nhãn 'admin' vào cuộc trao đổi của mình, và
      // giao diện sẽ hiển thị nó y như lời của Ban Quản Trị Học Viện.
      //
      // `threadEmail` bắt buộc khớp tài liệu cha — nếu không, người ta chèn được
      // lượt trả lời vào cuộc trao đổi của người khác chỉ bằng cách khai email
      // của chính mình.
      allow create: if signedIn()
                    && request.resource.data.threadEmail == threadOwner()
                    && request.resource.data.authorEmail == myEmail()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && (
                         (isAdmin() && request.resource.data.from == 'admin')
                         || (request.resource.data.from == 'student' && threadOwner() == myEmail())
                       );

      // Lượt đã gửi thì không ai sửa được, kể cả quản trị viên: nội dung hai bên
      // nhìn thấy phải là một, và phải đúng nội dung lúc gửi.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- /analytics : bộ đếm truy cập và thống kê ------------------------

    // Khách chưa đăng nhập cũng được tính lượt truy cập, nên buộc phải cho ghi
    // khi chưa đăng nhập. Bù lại chặn thổi số: mỗi lần ghi chỉ được cộng tối đa
    // 1, và không ai xoá được tài liệu.
    match /analytics/{docId} {
      allow read: if true;
      allow create: if true;
      allow delete: if false;

      // Quản trị viên được ghi giá trị tuỳ ý — cần cho việc đối soát số liệu
      // (reconcileGlobalStats), tức là ghi đè bộ đếm đã trôi bằng con số đếm
      // thật trên collection students. Người thường chỉ được cộng tối đa 1.
      allow update: if isAdmin()
                    || (visitsOk() && enrolledOk() && graduatesOk());
    }

    // ---- /site_banners : ảnh bìa trang chủ ---------------------------------

    // ĐỌC MỞ CHO TẤT CẢ, kể cả khách chưa đăng nhập. Ảnh bìa là thứ đầu tiên
    // hiện ra trên trang chủ, mà trang chủ thì ai cũng vào được. Đóng phần đọc
    // lại là khách nhìn thấy ảnh mặc định còn học viên thấy ảnh thật — hai
    // trang chủ khác nhau cho cùng một địa chỉ.
    //
    // GHI CHỈ QUẢN TRỊ VIÊN. Đây mới là ranh giới thật; nút "Đổi Ảnh Bìa" trên
    // giao diện chỉ là lớp sơn, ai gọi thẳng SDK cũng bỏ qua được nó.
    //
    // Chặn ảnh quá khổ ngay tại đây, không tin vào phần nén ở trình duyệt: một
    // tài liệu Firestore có trần cứng 1MB, và nếu để lọt một bản ghi sát trần
    // thì lệnh ghi hỏng ở tầng sâu hơn với thông báo khó hiểu hơn nhiều. 800KB
    // chừa đủ chỗ cho các trường còn lại. Phía trình duyệt tự ép về 700KB
    // (MAX_ENCODED_BYTES trong utils/bannerImage.js) nên bình thường không bao
    // giờ chạm mức này — nó là lưới an toàn, không phải hạn mức làm việc.
    match /site_banners/{bannerId} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.imageData is string
                            && request.resource.data.imageData.size() < 800000;
      allow delete: if isAdmin();
    }

    // ---- /site_config : cấu hình hiển thị chung ----------------------------

    // Hiện chỉ chứa `cover_slider` (thời gian đổi ảnh bìa). Đọc mở vì cùng lý
    // do với ảnh bìa: không có nó thì khách và học viên thấy hai tốc độ khác
    // nhau. Ghi chỉ quản trị viên.
    match /site_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Mặc định từ chối --------------------------------------------------

    // Collection nào chưa khai báo ở trên thì đóng. Thà hỏng rõ ràng còn hơn
    // mở âm thầm.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
